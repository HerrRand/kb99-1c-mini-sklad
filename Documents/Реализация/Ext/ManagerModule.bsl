#Область ПрограммныйИнтерфейс

Процедура Печать(ТабДок, Ссылка) Экспорт
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Макет = ПолучитьМакет("РеализацияТоваров");
	
	ДокОбъект = Ссылка.ПолучитьОбъект();
	Если ДокОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Номер = Строка(Ссылка.Номер);
	ОбластьШапка.Параметры.Дата  = Формат(Ссылка.Дата, "ДЛФ=DD.MM.YYYY");
	ТабДок.Вывести(ОбластьШапка);
	
	ОбластьТаблица = Макет.ПолучитьОбласть("Таблица");
	ОбластьТаблица.Параметры.Покупатель = ДокОбъект.Покупатель;
	ОбластьТаблица.Параметры.Склад      = ДокОбъект.Склад;
	ТабДок.Вывести(ОбластьТаблица);
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	НомерСтроки = 1;
	Итог = 0;
	Для Каждого СтрокаТЧ Из ДокОбъект.Товары Цикл
		ОбластьПодвал.Параметры.НомерСтроки = НомерСтроки;
		ОбластьПодвал.Параметры.Товар       = СтрокаТЧ.Товар;
		ОбластьПодвал.Параметры.Количество  = СтрокаТЧ.Количество;
		ОбластьПодвал.Параметры.Цена        = СтрокаТЧ.Цена;
		ОбластьПодвал.Параметры.Сумма       = СтрокаТЧ.Сумма;
		ТабДок.Вывести(ОбластьПодвал);
		Итог = Итог + СтрокаТЧ.Сумма;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");
	ОбластьИтог.Параметры.СуммаДокумента = Итог;
	ТабДок.Вывести(ОбластьИтог);
	
КонецПроцедуры

#КонецОбласти