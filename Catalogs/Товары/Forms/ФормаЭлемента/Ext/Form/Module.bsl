#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЦенаБезНДСПриИзменении(Элемент)
	
	ПересчитатьЦенуСНДС();
	
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСПриИзменении(Элемент)
	
	ПересчитатьЦенуСНДС();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПересчитатьЦенуСНДС()
	
	ЦенаБезНДС = Объект.ЦенаБезНДС;
	СтавкаНДС  = Объект.СтавкаНДС;
	
	Если ЦенаБезНДС = 0 Тогда
		Объект.ЦенаСНДС = 0;
		Возврат;
	КонецЕсли;
	
	ПроцентНДС = ПроцентСтавкиНДС(СтавкаНДС);
	
	Если ПроцентНДС = Неопределено Тогда
		Объект.ЦенаСНДС = 0;
		ТекстСообщения = "Неизвестная ставка НДС: " + Строка(СтавкаНДС)
			+ ". Цена с НДС сброшена в 0.";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Поле = "Объект.СтавкаНДС";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Объект.ЦенаСНДС = ЦенаБезНДС * (1 + ПроцентНДС / 100);
	
КонецПроцедуры

&НаКлиенте
Функция ПроцентСтавкиНДС(СтавкаНДС)
	
	Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкаНДС.БезНДС") Тогда
		Возврат 0;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкаНДС.Пять") Тогда
		Возврат 5;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкаНДС.Семь") Тогда
		Возврат 7;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкаНДС.Десять") Тогда
		Возврат 10;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкаНДС.ДвадцатьДва") Тогда
		Возврат 22;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

#КонецОбласти