#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Защита: форма не должна открываться без параметров
	Если НЕ Параметры.Свойство("Склад") ИЛИ НЕ ЗначениеЗаполнено(Параметры.Склад) Тогда
		Отказ = Истина;    
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не указан склад для подбора товаров.";
		Сообщение.Сообщить();	
		
		Возврат;
	КонецЕсли;
	
	Склад         = Параметры.Склад;
	ЭтоРеализация = Ложь; 
	
	Если Параметры.Свойство("ЭтоРеализация") Тогда
		ЭтоРеализация = Параметры.ЭтоРеализация;
	КонецЕсли;
	
	// Если дата документа не задана, берём текущую
	ДатаДокумента = ТекущаяДатаСеанса(); 
	
	Если Параметры.Свойство("ДатаДокумента") Тогда    
		ДатаДокумента = Параметры.ДатаДокумента;
	КонецЕсли;    
		
	Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ЗаполнитьСписокТоваров();
	НастроитьОформление();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ВыбранныеТовары = ПолучитьВыбранныеТовары();
	
	Если ВыбранныеТовары.Количество() = 0 Тогда 
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Отметьте хотя бы один товар и укажите количество.";
		Сообщение.Сообщить(); 
		
		Возврат;
	КонецЕсли;
	
	// Возвращаем результат в форму документа
	Закрыть(ВыбранныеТовары);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет список товаров с остатками на выбранном складе.
// Для реализации подставляется цена продажи, для поступления - закупочная.
&НаСервере
Процедура ЗаполнитьСписокТоваров()
	
	Запрос = Новый Запрос;
	// ВАЖНО: остатки сначала агрегируются по Товару, так как регистр партионный.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|    Остатки.Товар КАК Товар,
	|    СУММА(Остатки.КоличествоОстаток) КАК Остаток
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|    РегистрНакопления.ОстаткиТоваров.Остатки(&Дата, Склад = &Склад) КАК Остатки
	|СГРУППИРОВАТЬ ПО
	|    Остатки.Товар
	|ИНДЕКСИРОВАТЬ ПО
	|    Товар
	|;
	|ВЫБРАТЬ
	|    ЛОЖЬ КАК Отметка,
	|    Товары.Ссылка КАК Товар,
	|    Товары.Наименование КАК Наименование,
	|    Товары.Артикул КАК Артикул,
	|    ВЫБОР
	|        КОГДА &ЭтоРеализация ТОГДА Товары.ЦенаСНДС
	|        ИНАЧЕ Товары.ЦенаЗакупочная
	|    КОНЕЦ КАК Цена,
	|    ЕСТЬNULL(ВТ_Остатки.Остаток, 0) КАК Остаток,
	|    0 КАК Количество
	|ИЗ
	|    Справочник.Товары КАК Товары
	|        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|            ПО Товары.Ссылка = ВТ_Остатки.Товар
	|ГДЕ
	|    НЕ Товары.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|    Товары.Наименование";
	
	Запрос.УстановитьПараметр("Дата", ДатаДокумента);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ЭтоРеализация", ЭтоРеализация);
	
	ТоварыПодбора.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

// Собирает отмеченные товары в массив для возврата в документ. 
// Возвращаемое значение:
//   Массив из Структура - список выбранных товаров со свойствами:
//     * Товар - СправочникСсылка.Номенклатура - выбранный товар;
//     * Количество - Число - количество товара;
//     * Цена - Число - цена товара.
//
&НаКлиенте
Функция ПолучитьВыбранныеТовары()
	
	ВыбранныеТовары = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из ТоварыПодбора Цикл
		
		Если НЕ СтрокаТаблицы.Отметка ИЛИ СтрокаТаблицы.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Контроль остатка нужен только для реализации (расход со склада).
		// Для поступления это не проверяем - мы добавляем товар на склад.
		Если ЭтоРеализация И СтрокаТаблицы.Количество > СтрокаТаблицы.Остаток Тогда 
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Для """ + СтрокаТаблицы.Наименование + """ количество указано больше остатка.";
			Сообщение.Сообщить();
			Продолжить;
		КонецЕсли;
		
		СтрокаПодбора = Новый Структура("Товар, Количество, Цена",
		СтрокаТаблицы.Товар, СтрокаТаблицы.Количество, СтрокаТаблицы.Цена);
		ВыбранныеТовары.Добавить(СтрокаПодбора);
		
	КонецЦикла;
	
	Возврат ВыбранныеТовары;
	
КонецФункции

// Подсвечивает красным товары без остатка (только для реализации).
&НаСервере
Процедура НастроитьОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Если НЕ ЭтоРеализация Тогда
		Возврат;
	КонецЕсли;
	
	// ПРАВИЛО 1: Товара нет (Остаток <= 0)
	ЭлементНетТовара = УсловноеОформление.Элементы.Добавить();
	ЭлементНетТовара.Использование = Истина;
	
	ОтборНетТовара = ЭлементНетТовара.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборНетТовара.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыПодбора.Остаток");
	ОтборНетТовара.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	ОтборНетТовара.ПравоеЗначение = 0;
	ОтборНетТовара.Использование = Истина;
	
	СтильНетТовара = Метаданные.ЭлементыСтиля.Найти("ФонНетТовара");
	Если СтильНетТовара <> Неопределено Тогда
		ЭлементНетТовара.Оформление.УстановитьЗначениеПараметра("ЦветФона", СтильНетТовара.Значение);
	КонецЕсли;	 
	
	// ПРАВИЛО 2: Товар есть (Остаток > 0)
	ЭлементЕстьТовар = УсловноеОформление.Элементы.Добавить();
	ЭлементЕстьТовар.Использование = Истина;
	
	ОтборЕстьТовар = ЭлементЕстьТовар.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЕстьТовар.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыПодбора.Остаток");
	ОтборЕстьТовар.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ОтборЕстьТовар.ПравоеЗначение = 0;
	ОтборЕстьТовар.Использование = Истина;
	
	СтильЕстьТовар = Метаданные.ЭлементыСтиля.Найти("ФонЕстьТовар");  
	
	Если СтильЕстьТовар <> Неопределено Тогда
		ЭлементЕстьТовар.Оформление.УстановитьЗначениеПараметра("ЦветФона", СтильЕстьТовар.Значение);
	КонецЕсли;	      
	
	// Применяем оба правила ко ВСЕМ колонкам таблицы 
	Для Каждого ЭлементТаблицы Из Элементы.ТоварыПодбора.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ЭлементТаблицы) = Тип("ПолеФормы") Тогда
			
			ПолеНет = ЭлементНетТовара.Поля.Элементы.Добавить();
			ПолеНет.Поле = Новый ПолеКомпоновкиДанных(ЭлементТаблицы.Имя);
			ПолеНет.Использование = Истина;
			
			ПолеЕсть = ЭлементЕстьТовар.Поля.Элементы.Добавить();
			ПолеЕсть.Поле = Новый ПолеКомпоновкиДанных(ЭлементТаблицы.Имя);
			ПолеЕсть.Использование = Истина;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
#КонецОбласти