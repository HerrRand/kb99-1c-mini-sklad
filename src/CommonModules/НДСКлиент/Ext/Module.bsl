#Область СлужебныйПрограммныйИнтерфейс

// Возвращает процентную ставку НДС для указанного значения перечисления СтавкаНДС.
//
// Параметры:
//   СтавкаНДС - ПеречислениеСсылка.СтавкаНДС - ставка НДС, для которой требуется
//               получить процентное значение.
//
// Возвращаемое значение:
//   Число, Неопределено - процентная ставка НДС (0, 5, 7, 10, 22) или Неопределено,
//                         если переданная ставка отсутствует в соответствии.
//
Функция ПроцентСтавкиНДС(СтавкаНДС) Экспорт
	
	Ставки = СоответствиеСтавокНДС();
	
	Возврат Ставки[СтавкаНДС];
	
КонецФункции

// Возвращает соответствие значений перечисления СтавкаНДС и их процентных ставок.
// Используется для получения процента НДС по ссылке на значение перечисления.
//
// Возвращаемое значение:
//   Соответствие - ключ: ПеречислениеСсылка.СтавкаНДС, значение: Число - процентная
//                  ставка НДС (0, 5, 7, 10, 22).
//
Функция СоответствиеСтавокНДС() Экспорт
	
	Ставки = Новый Соответствие;
	Ставки.Вставить(ПредопределенноеЗначение("Перечисление.СтавкаНДС.БезНДС"),     0);
	Ставки.Вставить(ПредопределенноеЗначение("Перечисление.СтавкаНДС.Пять"),       5);
	Ставки.Вставить(ПредопределенноеЗначение("Перечисление.СтавкаНДС.Семь"),       7);
	Ставки.Вставить(ПредопределенноеЗначение("Перечисление.СтавкаНДС.Десять"),     10);
	Ставки.Вставить(ПредопределенноеЗначение("Перечисление.СтавкаНДС.ДвадцатьДва"), 22);
	
	Возврат Ставки;
	
КонецФункции

// Возвращает коэффициент перевода доли в проценты.
// Используется при расчёте сумм, где процентная ставка задана в долях.
//
// Возвращаемое значение:
//   Число - коэффициент перевода, равный 100.
//
Функция КоэффициентПереводаВПроценты() Экспорт
	
	Возврат 100;
	
КонецФункции

#КонецОбласти