#Область ПрограммныйИнтерфейс

Процедура Печать(ТабличныйДокумент, Ссылка) Экспорт
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	МакетПечати = ПолучитьМакет("РеализацияТоваров");
	
	ДокументОбъект = Ссылка.ПолучитьОбъект();
	Если ДокументОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбластьШапки = МакетПечати.ПолучитьОбласть("Шапка");
	ОбластьШапки.Параметры.Номер = Строка(Ссылка.Номер);
	ОбластьШапки.Параметры.Дата = Формат(Ссылка.Дата, "ДЛФ=DD.MM.YYYY");
	ТабличныйДокумент.Вывести(ОбластьШапки);
	
	ОбластьТаблица = МакетПечати.ПолучитьОбласть("Таблица");
	ОбластьТаблица.Параметры.Покупатель = ДокументОбъект.Покупатель;
	ОбластьТаблица.Параметры.Склад = ДокументОбъект.Склад;
	ТабличныйДокумент.Вывести(ОбластьТаблица);
	
	ОбластьЗаголовокТаблицы = МакетПечати.ПолучитьОбласть("ЗаголовокТаблицы");
	ТабличныйДокумент.Вывести(ОбластьЗаголовокТаблицы);
	
	ОбластьСтрокаТаблицы = МакетПечати.ПолучитьОбласть("Подвал");
	НомерСтрокиТаблицы = 1;
	ИтогоПоДокументу = 0;
	
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		
		ОбластьСтрокаТаблицы.Параметры.НомерСтроки = НомерСтрокиТаблицы;
		ОбластьСтрокаТаблицы.Параметры.Товар = СтрокаТовара.Товар;
		ОбластьСтрокаТаблицы.Параметры.Количество = СтрокаТовара.Количество;
		ОбластьСтрокаТаблицы.Параметры.Цена = СтрокаТовара.Цена;
		ОбластьСтрокаТаблицы.Параметры.Сумма = СтрокаТовара.Сумма;
		
		ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицы);
		
		ИтогоПоДокументу = ИтогоПоДокументу + СтрокаТовара.Сумма;
		НомерСтрокиТаблицы = НомерСтрокиТаблицы + 1;
		
	КонецЦикла;
	
	ОбластьИтога = МакетПечати.ПолучитьОбласть("Итог");
	ОбластьИтога.Параметры.СуммаДокумента = ИтогоПоДокументу;
	ТабличныйДокумент.Вывести(ОбластьИтога);
	
КонецПроцедуры

#КонецОбласти