#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();
	Движения.Продажи.Записывать = Истина;
	Движения.Продажи.Очистить();
	
	Движения.ОстаткиТоваров.Записать();
	
	ЗаблокироватьДанные();
	
	ТаблицаДанныхПоПартиям = ПолучитьДанныеПоПартиям(РежимПроведения);
	
	КонтрольОтрицательныхОстатков(ТаблицаДанныхПоПартиям, Отказ);
	Если Отказ Тогда
		Возврат; 
	КонецЕсли;
	
	УникальныеТовары = Новый Соответствие;
	Для Каждого СтрокаДанных Из ТаблицаДанныхПоПартиям Цикл
		УникальныеТовары.Вставить(СтрокаДанных.Товар, Истина);
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из УникальныеТовары Цикл
		ТекущийТовар = КлючИЗначение.Ключ;
		СписатьТоварПоФИФО(ТекущийТовар, ТаблицаДанныхПоПартиям);
	КонецЦикла;
	
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаблокироватьДанные()
	ИмяПоляТовар = "Товар";
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиТоваров");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = Товары;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных(ИмяПоляТовар, ИмяПоляТовар);
	ЭлементБлокировки.УстановитьЗначение("Склад", Склад);
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ПолучитьДанныеПоПартиям(РежимПроведения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|    Товары.Товар КАК Товар,
	|    СУММА(Товары.Количество) КАК КоличествоПоДокументу,
	|    СУММА(Товары.Сумма) КАК СуммаПоДокументу
	|ПОМЕСТИТЬ ВременнаяТаблицаТовары
	|ИЗ
	|    Документ.Реализация.Товары КАК Товары
	|ГДЕ
	|    Товары.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|    Товары.Товар
	|ИНДЕКСИРОВАТЬ ПО
	|    Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|    Остатки.Товар КАК Товар,
	|    Остатки.Партия КАК Партия,
	|    Остатки.КоличествоОстаток КАК КоличествоОстаток,
	|    Остатки.СуммаОстаток КАК СуммаОстаток
	|ПОМЕСТИТЬ ВременнаяТаблицаОстатки
	|ИЗ
	|    РегистрНакопления.ОстаткиТоваров.Остатки(
	|        &МоментВремени,
	|        Склад = &Склад
	|            И Товар В (ВЫБРАТЬ Товар КАК Товар ИЗ ВременнаяТаблицаТовары)) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|    ВременнаяТаблицаТовары.Товар КАК Товар,
	|    ВЫРАЗИТЬ(ВременнаяТаблицаТовары.Товар КАК Справочник.Товары).Представление КАК ТоварПредставление,
	|    ВременнаяТаблицаТовары.КоличествоПоДокументу КАК КоличествоПоДокументу,
	|    ВременнаяТаблицаТовары.СуммаПоДокументу КАК СуммаПоДокументу,
	|    ЕСТЬNULL(ВременнаяТаблицаОстатки.Партия, ЗНАЧЕНИЕ(Документ.Поступление.ПустаяСсылка)) КАК Партия,
	|    ЕСТЬNULL(ВременнаяТаблицаОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|    ЕСТЬNULL(ВременнаяТаблицаОстатки.СуммаОстаток, 0) КАК СуммаОстаток,
	|    ЕСТЬNULL(ДокументыПоступления.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПартии
	|ИЗ
	|    ВременнаяТаблицаТовары КАК ВременнаяТаблицаТовары
	|        ЛЕВОЕ СОЕДИНЕНИЕ ВременнаяТаблицаОстатки КАК ВременнаяТаблицаОстатки
	|            ПО ВременнаяТаблицаТовары.Товар = ВременнаяТаблицаОстатки.Товар
	|        ЛЕВОЕ СОЕДИНЕНИЕ Документ.Поступление КАК ДокументыПоступления
	|            ПО ВременнаяТаблицаОстатки.Партия = ДокументыПоступления.Ссылка
	|УПОРЯДОЧИТЬ ПО
	|    ВременнаяТаблицаТовары.Товар,
	|    ДатаПартии ВОЗР"; 
	
	Если РежимПроведения = РежимПроведенияДокумента.Оперативный Тогда
		ПараметрМоментВремени = Неопределено;
	Иначе
		ПараметрМоментВремени = МоментВремени();
	КонецЕсли;
	
	Запрос.УстановитьПараметр("МоментВремени", ПараметрМоментВремени);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
Процедура КонтрольОтрицательныхОстатков(ТаблицаДанныхПоПартиям, Отказ)
	
	УникальныеТовары = Новый Соответствие;
	Для Каждого СтрокаДанных Из ТаблицаДанныхПоПартиям Цикл
		УникальныеТовары.Вставить(СтрокаДанных.Товар, Истина);
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из УникальныеТовары Цикл
		ТекущийТовар = КлючИЗначение.Ключ;
		
		Отбор = Новый Структура("Товар", ТекущийТовар);
		МассивСтрокТовара = ТаблицаДанныхПоПартиям.НайтиСтроки(Отбор);
		
		ПерваяСтрока = МассивСтрокТовара[0];
		КоличествоПоДокументу = ПерваяСтрока.КоличествоПоДокументу;
		
		ОбщийОстаток = 0;
		Для Каждого СтрокаПартии Из МассивСтрокТовара Цикл
			ОбщийОстаток = ОбщийОстаток + СтрокаПартии.КоличествоОстаток;
		КонецЦикла;
		
		Если КоличествоПоДокументу > ОбщийОстаток Тогда
			Сообщение = Новый СообщениеПользователю;
			ТекстСообщения = "Не хватает товара " + ПерваяСтрока.ТоварПредставление;
			ТекстСообщения = ТекстСообщения + ". Требуется: " + КоличествоПоДокументу;
			ТекстСообщения = ТекстСообщения + ", в наличии: " + ОбщийОстаток;
			Сообщение.Текст = ТекстСообщения;
			Сообщение.Сообщить();
			
			Отказ = Истина; 
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СписатьТоварПоФИФО(ТекущийТовар, ТаблицаДанныхПоПартиям)
	Отбор = Новый Структура("Товар", ТекущийТовар);
	МассивСтрокТовара = ТаблицаДанныхПоПартиям.НайтиСтроки(Отбор);
	
	ПерваяСтрока = МассивСтрокТовара[0];
	КоличествоПоДокументу = ПерваяСтрока.КоличествоПоДокументу;
	СуммаПоДокументу = ПерваяСтрока.СуммаПоДокументу;
	
	КоличествоКСписанию = КоличествоПоДокументу;
	ИтоговаяСебестоимость = 0;
	
	Для Каждого СтрокаПартии Из МассивСтрокТовара Цикл
		Если КоличествоКСписанию <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если СтрокаПартии.КоличествоОстаток <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаПартии.КоличествоОстаток >= КоличествоКСписанию Тогда
			КоличествоИзПартии = КоличествоКСписанию;
		Иначе
			КоличествоИзПартии = СтрокаПартии.КоличествоОстаток;
		КонецЕсли;
		
		СебестоимостьЧасти = (КоличествоИзПартии / СтрокаПартии.КоличествоОстаток) * СтрокаПартии.СуммаОстаток;
		
		СтрокаПартии.КоличествоОстаток = СтрокаПартии.КоличествоОстаток - КоличествоИзПартии;
		СтрокаПартии.СуммаОстаток = СтрокаПартии.СуммаОстаток - СебестоимостьЧасти;
		
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = ТекущийТовар;
		Движение.Склад = Склад;
		Движение.Партия = СтрокаПартии.Партия;
		Движение.Количество = КоличествоИзПартии;
		Движение.Сумма = СебестоимостьЧасти;
		
		ИтоговаяСебестоимость = ИтоговаяСебестоимость + СебестоимостьЧасти;
		КоличествоКСписанию = КоличествоКСписанию - КоличествоИзПартии;
	КонецЦикла;
	
	ДвижениеПродажи = Движения.Продажи.Добавить();
	ДвижениеПродажи.Период = Дата;
	ДвижениеПродажи.Товар = ТекущийТовар;
	ДвижениеПродажи.Покупатель = Покупатель;
	ДвижениеПродажи.Количество = КоличествоПоДокументу;
	ДвижениеПродажи.Сумма = СуммаПоДокументу;
	ДвижениеПродажи.Себестоимость = ИтоговаяСебестоимость;
КонецПроцедуры

#КонецОбласти