#Область ПрограммныйИнтерфейс

Процедура ОбработкаПроведения(Отказ, Режим)
	
	КонтрольОтрицательныхОстатков(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период      = Дата;
		Движение.Товар       = ТекСтрокаТовары.Товар;
		Движение.Склад       = Склад;
		Движение.Количество  = ТекСтрокаТовары.Количество;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура КонтрольОтрицательныхОстатков(Отказ)
	
	ТоварыДокумента = Новый ТаблицаЗначений;
	ТоварыДокумента.Колонки.Добавить("Товар");
	ТоварыДокумента.Колонки.Добавить("Количество");
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		Если СтрокаТЧ.Товар = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Найденная = ТоварыДокумента.Найти(СтрокаТЧ.Товар, "Товар");
		Если Найденная = Неопределено Тогда
			НоваяСтрока = ТоварыДокумента.Добавить();
			НоваяСтрока.Товар      = СтрокаТЧ.Товар;
			НоваяСтрока.Количество = СтрокаТЧ.Количество;
		Иначе
			Найденная.Количество = Найденная.Количество + СтрокаТЧ.Количество;
		КонецЕсли;
	КонецЦикла;
	
	Если ТоварыДокумента.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросОстатки = Новый Запрос;
	ЗапросОстатки.Текст =
	"ВЫБРАТЬ
	|	Остатки.Товар КАК Товар,
	|	Остатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(
	|		&МоментВремени,
	|		Товар В (&Товары)
	|			И Склад = &Склад) КАК Остатки";
	
	ЗапросОстатки.УстановитьПараметр("МоментВремени", МоментВремени());
	ЗапросОстатки.УстановитьПараметр("Товары", ТоварыДокумента.ВыгрузитьКолонку("Товар"));
	ЗапросОстатки.УстановитьПараметр("Склад", Склад);
	
	ОстаткиПоТоварам = Новый Соответствие;
	ВыборкаОстатки = ЗапросОстатки.Выполнить().Выбрать();
	Пока ВыборкаОстатки.Следующий() Цикл
		ОстаткиПоТоварам.Вставить(ВыборкаОстатки.Товар, ВыборкаОстатки.КоличествоОстаток);
	КонецЦикла;
	
	ЗапросДвижений = Новый Запрос;
	ЗапросДвижений.Текст =
	"ВЫБРАТЬ
	|	Движения.Товар КАК Товар,
	|	СУММА(Движения.Количество) КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Регистратор
	|	И Движения.Склад = &Склад
	|СГРУППИРОВАТЬ ПО
	|	Движения.Товар";
	
	ЗапросДвижений.УстановитьПараметр("Регистратор", Ссылка);
	ЗапросДвижений.УстановитьПараметр("Склад", Склад);
	
	ДвиженияДокумента = Новый Соответствие;
	ВыборкаДвижений = ЗапросДвижений.Выполнить().Выбрать();
	Пока ВыборкаДвижений.Следующий() Цикл
		ДвиженияДокумента.Вставить(ВыборкаДвижений.Товар, ВыборкаДвижений.Количество);
	КонецЦикла;
	
	Для Каждого СтрокаТЧ Из ТоварыДокумента Цикл
		Остаток = ОстаткиПоТоварам[СтрокаТЧ.Товар];
		Если Остаток = Неопределено Тогда
			Остаток = 0;
		КонецЕсли;
		
		ДвижениеДокумента = ДвиженияДокумента[СтрокаТЧ.Товар];
		Если ДвижениеДокумента = Неопределено Тогда
			ДвижениеДокумента = 0;
		КонецЕсли;
		ДоступныйОстаток = Остаток + ДвижениеДокумента;
		
		Если ДоступныйОстаток < СтрокаТЧ.Количество Тогда
			ТекстСообщения = "Недостаточно товара """ + Строка(СтрокаТЧ.Товар)
				+ """ на складе """ + Строка(Склад) + """."
				+ Символы.ПС + "Требуется: " + СтрокаТЧ.Количество
				+ ", доступно: " + ДоступныйОстаток + ".";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстСообщения;
			Сообщение.Поле = "Товары";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти