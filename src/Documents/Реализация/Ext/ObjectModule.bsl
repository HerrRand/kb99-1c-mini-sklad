#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	КонтрольОтрицательныхОстатков(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаТовары.Товар;
		Движение.Склад = Склад;
		Движение.Количество = ТекСтрокаТовары.Количество;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура КонтрольОтрицательныхОстатков(Отказ)
	
	ТоварыДокумента = СформироватьТоварыДокумента(Товары);
	
	Если ТоварыДокумента.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОстаткиПоТоварам  = ПолучитьОстаткиПоТоварам(ТоварыДокумента, Склад);
	ДвиженияДокумента = ПолучитьДвиженияДокумента(Ссылка, Склад);
	
	ПроверитьДоступностьИВывестиОшибки(ТоварыДокумента, ОстаткиПоТоварам, ДвиженияДокумента, Склад, Отказ);
	
КонецПроцедуры

Функция СформироватьТоварыДокумента(ИсходныеТовары)
	
	ТоварыДокумента = Новый ТаблицаЗначений;
	ТоварыДокумента.Колонки.Добавить("Товар");
	ТоварыДокумента.Колонки.Добавить("Количество");
	
	Для Каждого СтрокаТовара Из ИсходныеТовары Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовара.Товар) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТовараНайдена = ТоварыДокумента.Найти(СтрокаТовара.Товар, "Товар");
		Если СтрокаТовараНайдена = Неопределено Тогда
			НоваяСтрокаТаблицы = ТоварыДокумента.Добавить();
			НоваяСтрокаТаблицы.Товар = СтрокаТовара.Товар;
			НоваяСтрокаТаблицы.Количество = СтрокаТовара.Количество;
		Иначе
			СтрокаТовараНайдена.Количество = СтрокаТовараНайдена.Количество + СтрокаТовара.Количество;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТоварыДокумента;
	
КонецФункции

Функция ПолучитьОстаткиПоТоварам(ТоварыДокумента, ТекущийСклад)
	
	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст =
	"ВЫБРАТЬ
	|	Остатки.Товар КАК Товар,
	|	Остатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(
	|		&МоментВремени,
	|		Товар В (&Товары)
	|			И Склад = &Склад) КАК Остатки";
	
	ЗапросОстатков.УстановитьПараметр("МоментВремени", МоментВремени());
	ЗапросОстатков.УстановитьПараметр("Товары", ТоварыДокумента.ВыгрузитьКолонку("Товар"));
	ЗапросОстатков.УстановитьПараметр("Склад", ТекущийСклад);
	
	ОстаткиПоТоварам = Новый Соответствие;
	ВыборкаОстатки = ЗапросОстатков.Выполнить().Выбрать();
	Пока ВыборкаОстатки.Следующий() Цикл
		ОстаткиПоТоварам.Вставить(ВыборкаОстатки.Товар, ВыборкаОстатки.КоличествоОстаток);
	КонецЦикла;
	
	Возврат ОстаткиПоТоварам;
	
КонецФункции

Функция ПолучитьДвиженияДокумента(ДокументСсылка, ТекущийСклад)
	
	ЗапросДвиженийДокумента = Новый Запрос;
	ЗапросДвиженийДокумента.Текст =
	"ВЫБРАТЬ
	|	Движения.Товар КАК Товар,
	|	СУММА(Движения.Количество) КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Регистратор
	|	И Движения.Склад = &Склад
	|СГРУППИРОВАТЬ ПО
	|	Движения.Товар";
	
	ЗапросДвиженийДокумента.УстановитьПараметр("Регистратор", ДокументСсылка);
	ЗапросДвиженийДокумента.УстановитьПараметр("Склад",       ТекущийСклад);
	
	ДвиженияДокумента = Новый Соответствие;
	ВыборкаДвижений = ЗапросДвиженийДокумента.Выполнить().Выбрать();
	Пока ВыборкаДвижений.Следующий() Цикл
		ДвиженияДокумента.Вставить(ВыборкаДвижений.Товар, ВыборкаДвижений.Количество);
	КонецЦикла;
	
	Возврат ДвиженияДокумента;
	
КонецФункции

Процедура ПроверитьДоступностьИВывестиОшибки(ТоварыДокумента, ОстаткиПоТоварам, ДвиженияДокумента, ТекущийСклад, Отказ)
	
	Для Каждого СтрокаТовара Из ТоварыДокумента Цикл
		Остаток = ОстаткиПоТоварам[СтрокаТовара.Товар];
		Если Остаток = Неопределено Тогда
			Остаток = 0;
		КонецЕсли;
		
		ДвижениеДокумента = ДвиженияДокумента[СтрокаТовара.Товар];
		Если ДвижениеДокумента = Неопределено Тогда
			ДвижениеДокумента = 0;
		КонецЕсли;
		ДоступныйОстаток = Остаток + ДвижениеДокумента;
		
		Если ДоступныйОстаток < СтрокаТовара.Количество Тогда
			ТекстСообщения = "Недостаточно товара """ + Строка(СтрокаТовара.Товар)
			+ """ на складе """ + Строка(ТекущийСклад) + """."
			+ Символы.ПС + "Требуется: " + СтрокаТовара.Количество
			+ ", доступно: " + ДоступныйОстаток + ".";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстСообщения;
			Сообщение.Поле = "Товары";
			Сообщение.Сообщить(); 
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти