#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	ПересчетСуммыДокументов.РассчитатьСумму(СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	ПересчетСуммыДокументов.РассчитатьСумму(СтрокаТабличнойЧасти);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СверкаОстатков(Команда)
	СверкаОстатковНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВсеТоварыСОстаткамиНаСервере()
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	// 1. Выгружаем остатки в временную таблицу
	ЗапросОстатки = Новый Запрос;
	ЗапросОстатки.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросОстатки.Текст = 
	"ВЫБРАТЬ
	|    Остатки.Товар КАК Товар,
	|    ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Количество
	|ПОМЕСТИТЬ ВременнаяТаблицаОстатки
	|ИЗ
	|    РегистрНакопления.ОстаткиТоваров.Остатки(&Дата) КАК Остатки";
	ЗапросОстатки.УстановитьПараметр("Дата", Объект.Дата);
	ЗапросОстатки.Выполнить();
	
	// 2. Финальный запрос: соединяем справочник с временной таблицей остатков
	ЗапросИтог = Новый Запрос;
	ЗапросИтог.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросИтог.Текст = 
	"ВЫБРАТЬ
	|    Товары.Ссылка КАК Товар,
	|    Товары.Артикул КАК Артикул,
	|    ЕСТЬNULL(ВременнаяТаблицаОстатки.Количество, 0) КАК Количество
	|ИЗ
	|    Справочник.Товары КАК Товары
	|        ЛЕВОЕ СОЕДИНЕНИЕ ВременнаяТаблицаОстатки КАК ВременнаяТаблицаОстатки
	|        ПО Товары.Ссылка = ВременнаяТаблицаОстатки.Товар
	|ГДЕ
	|    НЕ Товары.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|    Товары.Ссылка";
	
	Результат = ЗапросИтог.Выполнить().Выгрузить();
	
	ПредставлениеДаты = Формат(Объект.Дата, "ДЛФ=DT");
	
	Если Результат.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Нет товаров в справочнике на дату " + ПредставлениеДаты;
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ЧастиСообщения = Новый Массив;
	ЧастиСообщения.Добавить("Остатки всех товаров на дату " + ПредставлениеДаты + ":");
	
	Для Каждого Строка Из Результат Цикл
		// Формируем строку отдельно (по стандартам 1С)
		ТекстСтроки = "  " + Строка(Строка.Товар) 
		+ " (арт. " + Строка.Артикул + ") - " 
		+ Строка.Количество + " шт.";
		
		ЧастиСообщения.Добавить(ТекстСтроки);
	КонецЦикла;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрСоединить(ЧастиСообщения, Символы.ПС);
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаКлиенте
Процедура ВсеТоварыСОстатками(Команда)
	ВсеТоварыСОстаткамиНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере

Процедура СверкаОстатковНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Товар КАК Товар,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(
	|		&Дата,
	|		Склад = &Склад) КАК Остатки";
	
	Запрос.УстановитьПараметр("Дата",  Объект.Дата);
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ПредставлениеСклада = Строка(Объект.Склад);
	ПредставлениеДаты   = Формат(Объект.Дата, "ДЛФ=DT");
	
	Если Результат.Количество() = 0 Тогда
		
		ТекстСообщения = "На складе """ + ПредставлениеСклада + """ на дату "
		+ ПредставлениеДаты + " остатков нет.";
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
		
		Возврат;
		
	КонецЕсли;
	
	Шапка = "Остатки на складе """ + ПредставлениеСклада + """ на дату "
	+ ПредставлениеДаты + ":";
	
	ЧастиСообщения = Новый Массив;
	ЧастиСообщения.Добавить(Шапка);
	
	Для Каждого Строка Из Результат Цикл
		ЧастиСообщения.Добавить("  " + Строка(Строка.Товар) + " - " + Строка.Количество + " шт.");
	КонецЦикла;
	
	ТекстСообщения = СтрСоединить(ЧастиСообщения, Символы.ПС);
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти   
