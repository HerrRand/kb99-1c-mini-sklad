#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	ПересчетСуммыДокументов.РассчитатьСумму(СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	ПересчетСуммыДокументов.РассчитатьСумму(СтрокаТабличнойЧасти);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СверкаОстатков(Команда)
	СверкаОстатковНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СверкаОстатковНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Товар КАК Товар,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(
	|		&Дата,
	|		Склад = &Склад) КАК Остатки";
	
	Запрос.УстановитьПараметр("Дата",  Объект.Дата);
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ПредставлениеСклада = Строка(Объект.Склад);
	ПредставлениеДаты   = Формат(Объект.Дата, "ДЛФ=DT");
	
	Если Результат.Количество() = 0 Тогда
		
		ТекстСообщения = "На складе """ + ПредставлениеСклада + """ на дату "
		+ ПредставлениеДаты + " остатков нет.";
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
		
		Возврат;
		
	КонецЕсли;
	
	Шапка = "Остатки на складе """ + ПредставлениеСклада + """ на дату "
	+ ПредставлениеДаты + ":";
	
	ЧастиСообщения = Новый Массив;
	ЧастиСообщения.Добавить(Шапка);
	
	Для Каждого Строка Из Результат Цикл
		ЧастиСообщения.Добавить("  " + Строка(Строка.Товар) + " - " + Строка.Количество + " шт.");
	КонецЦикла;
	
	ТекстСообщения = СтрСоединить(ЧастиСообщения, Символы.ПС);
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти   
