#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
	ПересчетСуммыДокументов.РассчитатьСумму(СтрокаТЧ);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
	ПересчетСуммыДокументов.РассчитатьСумму(СтрокаТЧ);
	
	
КонецПроцедуры

&НаСервере
Процедура СверкаОстатковНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Товар КАК Товар,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(
	|		&Дата,
	|		Склад = &Склад) КАК Остатки";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		Сообщить("На складе """ + Строка(Объект.Склад) + """ на дату " 
		+ Формат(Объект.Дата, "ДЛФ=DT") + " остатков нет.");
		Возврат;
	КонецЕсли;
	
	Текст = "Остатки на складе """ + Строка(Объект.Склад) + """ на дату "
	+ Формат(Объект.Дата, "ДЛФ=DT") + ":" + Символы.ПС;
	
	Для Каждого Строка Из Результат Цикл
		Текст = Текст + "  " + Строка(Строка.Товар) + " — " + Строка.Количество + " шт." + Символы.ПС;
	КонецЦикла;
	
	Сообщить(Текст);
КонецПроцедуры

&НаКлиенте
Процедура СверкаОстатков(Команда)
	СверкаОстатковНаСервере();
КонецПроцедуры

#КонецОбласти   

