#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	ПересчетСуммыДокументов.РассчитатьСумму(СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	ПересчетСуммыДокументов.РассчитатьСумму(СтрокаТабличнойЧасти);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СверкаОстатков(Команда)
	СверкаОстатковНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВсеТоварыСОстатками(Команда)
	ВсеТоварыСОстаткамиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПодборТоваров(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Сначала укажите склад.";
		Сообщение.Поле = "Объект.Склад";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Склад, ДатаДокумента, ЭтоРеализация",
	Объект.Склад, Объект.Дата, Истина);
	
	Оповещение = Новый ОписаниеОповещения("ПодборТоваровЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораТоваров",
	ПараметрыФормы,
	ЭтотОбъект,
	Новый УникальныйИдентификатор,
	,
	,
	Оповещение); // ОповещениеОЗакрытии
	
КонецПроцедуры

// Сюда форма подбора возвращает выбранные товары.
&НаКлиенте
Процедура ПодборТоваровЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ВыбранныйТовар Из РезультатЗакрытия Цикл
		
		НоваяСтрока = Объект.Товары.Добавить();
		НоваяСтрока.Товар      = ВыбранныйТовар.Товар;
		НоваяСтрока.Количество = ВыбранныйТовар.Количество;
		НоваяСтрока.Цена       = ВыбранныйТовар.Цена;
		
		ПересчетСуммыДокументов.РассчитатьСумму(НоваяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СверкаОстатковНаСервере()
	
	Если Объект.Товары.Количество() = 0 Тогда
		СообщениеОбОстатках = Новый СообщениеПользователю;
		СообщениеОбОстатках.Текст = "Табличная часть ""Товары"" пуста. Нечего сверять.";
		СообщениеОбОстатках.Сообщить();
		Возврат;
	КонецЕсли;
	
	МассивТоваров = Новый Массив;
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.Товар) И МассивТоваров.Найти(СтрокаТЧ.Товар) = Неопределено Тогда
			МассивТоваров.Добавить(СтрокаТЧ.Товар);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|    О.Товар КАК Товар,
	|    СУММА(О.КоличествоОстаток) КАК КоличествоОстаток
	|ИЗ
	|    РегистрНакопления.ОстаткиТоваров.Остатки(&Дата, Склад = &Склад И Товар В (&МассивТоваров)) КАК О
	|СГРУППИРОВАТЬ ПО
	|    О.Товар";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	Запрос.УстановитьПараметр("МассивТоваров", МассивТоваров);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ОстаткиПоТоварам = Новый Соответствие;
	Для Каждого Строка Из Результат Цикл
		ОстаткиПоТоварам.Вставить(Строка.Товар, Строка.КоличествоОстаток);
	КонецЦикла;
	
	ПредставлениеСклада = ?(ЗначениеЗаполнено(Объект.Склад), Строка(Объект.Склад), "Не указан");
	ПредставлениеДаты = Формат(Объект.Дата, "ДЛФ=DT");
	
	ЧастиСообщения = Новый Массив;
	ЧастиСообщения.Добавить("Сверка остатков на складе """ + ПредставлениеСклада + """ на " + ПредставлениеДаты + ":");
	
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		ИмяТовара = Строка(СтрокаТЧ.Товар);
		КоличествоВДокументе = СтрокаТЧ.Количество;
		Доступно = ?(ОстаткиПоТоварам.Получить(СтрокаТЧ.Товар) = Неопределено, 0, ОстаткиПоТоварам.Получить(СтрокаТЧ.Товар));
		
		ТекстСтроки = "  • " + ИмяТовара + ": в документе " + Формат(КоличествоВДокументе, "ЧДЦ=2") 
		+ " шт., доступно: " + Формат(Доступно, "ЧДЦ=2; ЧН=0") + " шт.";
		
		Если Доступно < КоличествоВДокументе Тогда
			ТекстСтроки = "НЕХВАТКА: " + ТекстСтроки;
		КонецЕсли;
		
		ЧастиСообщения.Добавить(ТекстСтроки);
	КонецЦикла;
	
	СообщениеОбОстатках = Новый СообщениеПользователю;
	СообщениеОбОстатках.Текст = СтрСоединить(ЧастиСообщения, Символы.ПС);
	СообщениеОбОстатках.Сообщить();
	
КонецПроцедуры

&НаСервере
Процедура ВсеТоварыСОстаткамиНаСервере()
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	// 1. Выгружаем остатки в временную таблицу (с фильтром по складу)
	ЗапросОстатки = Новый Запрос;
	ЗапросОстатки.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросОстатки.Текст = 
	"ВЫБРАТЬ
	|    Остатки.Товар КАК Товар,
	|    ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Количество
	|ПОМЕСТИТЬ ВременнаяТаблицаОстатки
	|ИЗ
	|    РегистрНакопления.ОстаткиТоваров.Остатки(&Дата, Склад = &Склад) КАК Остатки";
	ЗапросОстатки.УстановитьПараметр("Дата", Объект.Дата);
	ЗапросОстатки.УстановитьПараметр("Склад", Объект.Склад);
	ЗапросОстатки.Выполнить();
	
	// 2. Финальный запрос: соединяем справочник с временной таблицей остатков
	ЗапросИтог = Новый Запрос;
	ЗапросИтог.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросИтог.Текст = 
	"ВЫБРАТЬ
	|    Товары.Ссылка КАК Товар,
	|    Товары.Наименование КАК Наименование,
	|    Товары.Артикул КАК Артикул,
	|    ЕСТЬNULL(ВременнаяТаблицаОстатки.Количество, 0) КАК Количество
	|ИЗ
	|    Справочник.Товары КАК Товары
	|        ЛЕВОЕ СОЕДИНЕНИЕ ВременнаяТаблицаОстатки КАК ВременнаяТаблицаОстатки
	|        ПО Товары.Ссылка = ВременнаяТаблицаОстатки.Товар
	|ГДЕ
	|    НЕ Товары.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|    Товары.Наименование";
	
	Результат = ЗапросИтог.Выполнить().Выгрузить();
	
	ПредставлениеДаты = Формат(Объект.Дата, "ДЛФ=DT");
	ПредставлениеСклада = ?(ЗначениеЗаполнено(Объект.Склад), Строка(Объект.Склад), "Не указан");
	
	Если Результат.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Нет товаров в справочнике на дату " + ПредставлениеДаты;
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	МаксимумСтрок = 200;
	КоличествоСтрок = Мин(Результат.Количество(), МаксимумСтрок);   
	ЧастиСообщения = Новый Массив;
	ЧастиСообщения.Добавить("Остатки всех товаров на складе """ + ПредставлениеСклада
	+ """ на дату " + ПредставлениеДаты
	+ " (показано первых " + КоличествоСтрок + "):");
	Счетчик = 0; 
	
	Для Каждого Строка Из Результат Цикл
		Если Счетчик >= МаксимумСтрок Тогда
			Прервать;
		КонецЕсли;
		
		ИмяТовара = ?(ЗначениеЗаполнено(Строка.Наименование), Строка.Наименование, Строка(Строка.Товар));
		АртикулЧасть = ?(ЗначениеЗаполнено(Строка.Артикул), " (арт. " + Строка.Артикул + ")", "");
		
		ТекстСтроки = "  " + ИмяТовара + АртикулЧасть 
		+ " - " + Формат(Строка.Количество, "ЧДЦ=2; ЧН=0") + " шт.";
		
		ЧастиСообщения.Добавить(ТекстСтроки);
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
	Если Результат.Количество() > МаксимумСтрок Тогда
		ЧастиСообщения.Добавить("  ... и еще " + (Результат.Количество() - МаксимумСтрок) + " позиций.");
	КонецЕсли;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрСоединить(ЧастиСообщения, Символы.ПС);
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти