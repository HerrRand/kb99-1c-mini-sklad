#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЦенаБезНДСПриИзменении(Элемент)
	
	ПересчитатьЦенуСНДС();
	
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСПриИзменении(Элемент)
	
	ПересчитатьЦенуСНДС();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПересчитатьЦенуСНДС()
	
	ЦенаБезНДС = Объект.ЦенаБезНДС;
	СтавкаНДС  = Объект.СтавкаНДС;
	
	Если ЦенаБезНДС = 0 Тогда
		Объект.ЦенаСНДС = 0;
		Возврат;
	КонецЕсли;
	
	ПроцентНДС = ПроцентСтавкиНДС(СтавкаНДС);
	
	Если ПроцентНДС = Неопределено Тогда
		Объект.ЦенаСНДС = 0;
		ТекстСообщения = "Неизвестная ставка НДС: " + Строка(СтавкаНДС)
		+ ". Цена с НДС сброшена в 0.";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Поле = "Объект.СтавкаНДС";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Объект.ЦенаСНДС = ЦенаБезНДС * (1 + ПроцентНДС / КоэффициентПереводаВПроценты());
	
КонецПроцедуры

&НаКлиенте
Функция КоэффициентПереводаВПроценты()
	
	Возврат 100;
	
КонецФункции

&НаКлиенте
Функция ПроцентСтавкиНДС(СтавкаНДС)
	
	Ставки = СоответствиеСтавокНДС();
	
	Возврат Ставки[СтавкаНДС];
	
КонецФункции

&НаКлиенте
Функция СоответствиеСтавокНДС()
	
	Ставки = Новый Соответствие;
	Ставки.Вставить(ПредопределенноеЗначение("Перечисление.СтавкаНДС.БезНДС"),     0);
	Ставки.Вставить(ПредопределенноеЗначение("Перечисление.СтавкаНДС.Пять"),       5);
	Ставки.Вставить(ПредопределенноеЗначение("Перечисление.СтавкаНДС.Семь"),       7);
	Ставки.Вставить(ПредопределенноеЗначение("Перечисление.СтавкаНДС.Десять"),     10);
	Ставки.Вставить(ПредопределенноеЗначение("Перечисление.СтавкаНДС.ДвадцатьДва"), 22);
	
	Возврат Ставки;
	
КонецФункции
#КонецОбласти