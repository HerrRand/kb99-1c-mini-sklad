#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЦенаБезНДСПриИзменении(Элемент)
	
	ПересчитатьЦенуСНДС();
	
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСПриИзменении(Элемент)
	
	ПересчитатьЦенуСНДС();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПересчитатьЦенуСНДС()
	
	ЦенаБезНДС = Объект.ЦенаБезНДС;
	СтавкаНДС  = Объект.СтавкаНДС;
	
	Если ЦенаБезНДС = 0 Тогда
		Объект.ЦенаСНДС = 0;
		Возврат;
	КонецЕсли;
	
	ПроцентНДС = НДСКлиент.ПроцентСтавкиНДС(СтавкаНДС);
	
	Если ПроцентНДС = Неопределено Тогда
		Объект.ЦенаСНДС = 0;
		ТекстСообщения = "Неизвестная ставка НДС: " + Строка(СтавкаНДС)
		+ ". Цена с НДС сброшена в 0.";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Поле = "Объект.СтавкаНДС";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Объект.ЦенаСНДС = ЦенаБезНДС * (1 + ПроцентНДС / НДСКлиент.КоэффициентПереводаВПроценты());
	
КонецПроцедуры

#КонецОбласти